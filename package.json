{
  "name": "@local/dsh-agent-runtime",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Shared agent runtimes, isolated tasks and Factory workflows for DSH",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./types": "./types.d.ts"
  },
  "files": [
    "dist/**/*.js",
    "!dist/test/",
    "index.ts",
    "client.ts",
    "types.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/dsh-agent-runtime.git"
  },
  "homepage": "https://github.com/bondiano/dsh-agent-runtime#readme",
  "bugs": {
    "url": "https://github.com/bondiano/dsh-agent-runtime/issues"
  },
  "dependencies": {
    "xstate": "5.33.4"
  }
}
